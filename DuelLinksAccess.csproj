<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runtime Type from MelonLoader log: net6 → net6.0 -->
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>

    <AssemblyName>DuelLinksAccess</AssemblyName>
    <RootNamespace>DuelLinksAccess</RootNamespace>
    <Version>1.4.2</Version>

    <DuelLinksPath Condition="'$(DuelLinksPath)' == '' and '$(DUEL_LINKS_PATH)' != ''">$(DUEL_LINKS_PATH)</DuelLinksPath>
    <DuelLinksPath Condition="'$(DuelLinksPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Yu-Gi-Oh! Duel Links</DuelLinksPath>
    <MelonLoaderPath>$(DuelLinksPath)\MelonLoader</MelonLoaderPath>
    <GameAssembliesPath>$(MelonLoaderPath)\Il2CppAssemblies</GameAssembliesPath>
    <DeployToMods Condition="'$(DeployToMods)' == ''">false</DeployToMods>
  </PropertyGroup>

  <!-- Exclude decompiled files and templates from build -->
  <ItemGroup>
    <Compile Remove="decompiled\**" />
    <Compile Remove="templates\**" />
    <Compile Remove="tests\**" />
  </ItemGroup>

  <!-- MelonLoader References (net6) -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderPath)\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderPath)\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Il2CppInterop Runtime and IL2CPP core (required for IL2CPP games) -->
  <ItemGroup>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderPath)\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameAssembliesPath)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Il2CppSystem.Core provides the interop HashSet&lt;T&gt; used by
         CardTransferViewController.selected (the exchange-selection set). -->
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(GameAssembliesPath)\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity Interop Assemblies (from MelonLoader Il2CppAssemblies) -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GameAssembliesPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameAssembliesPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameAssembliesPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameAssembliesPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameAssembliesPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameAssembliesPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game Assembly (IL2CPP interop) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameAssembliesPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MelonLoaderPath)\net6\MelonLoader.dll')"
           Text="MelonLoader assemblies not found under '$(DuelLinksPath)'. Set DuelLinksPath with -p:DuelLinksPath=... or DUEL_LINKS_PATH." />
    <Error Condition="!Exists('$(GameAssembliesPath)\Assembly-CSharp.dll')"
           Text="Generated IL2CPP assemblies not found under '$(GameAssembliesPath)'. Run Duel Links through MelonLoader once." />
  </Target>

  <!-- Deployment is opt-in so ordinary builds never modify the game install. -->
  <Target Name="CopyToMods" AfterTargets="Build"
          Condition="'$(DeployToMods)' == 'true' and '$(SkipCopyToMods)' != 'true'">
    <MakeDir Directories="$(DuelLinksPath)\Mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DuelLinksPath)\Mods\" />
    <Message Text="Copied $(TargetFileName) to Mods folder" Importance="High" />
  </Target>

</Project>
